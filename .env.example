# Copy to .env for local development. `make up` starts the dependencies these
# point at.

APP_ENV=development
APP_VERSION=dev
LOG_LEVEL=debug
LOG_FORMAT=text

HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Cookies are only sent over TLS when this is on, so it must be off for a
# plain-HTTP local dashboard and on everywhere else. config.Load refuses to
# start in production with it off.
SECURE_COOKIES=false
# How many reverse proxies sit in front. 0 means X-Forwarded-For is ignored
# entirely, which is the only safe default: the header is attacker-controlled
# until a known number of trusted hops is counted from the right.
TRUSTED_PROXY_HOPS=0

# The runtime role, NOT the migration owner. postgres.Open refuses to start if
# this role is a superuser or has BYPASSRLS, because row-level security would
# not isolate anything.
DATABASE_URL=postgres://expense_app:local_app_pw@127.0.0.1:5441/expenses?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_SLOW_QUERY_THRESHOLD=250ms
# Asserts after every transaction that the tenant binding really went out of
# scope. One extra round trip; on in development and staging, off in
# production where the property is structural rather than probabilistic.
DB_VERIFY_TENANT_RESET=true

# The migration owner. Used by `make migrate-up`, never by the application.
GOOSE_DBSTRING=postgres://expense:local_dev_pw@127.0.0.1:5441/expenses?sslmode=disable

REDIS_ADDR=127.0.0.1:6390

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-thirty-two-bytes-of-random
JWT_TTL=15m
REFRESH_TTL=720h

# Receipt storage. Any S3-compatible store; `make up` runs MinIO.
# Leave STORAGE_ENDPOINT empty to run without receipts - the attachment
# endpoints then answer 501 and the API says so at startup.
STORAGE_ENDPOINT=http://127.0.0.1:9010
# Where a browser reaches the store, when that differs from where the API does.
# Running the API in a container it would be http://minio:9000 above and this
# below, because the host is part of the presigned URL's signature and cannot be
# rewritten afterwards. Empty means the two are the same.
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=receipts
STORAGE_ACCESS_KEY=local_storage_key
STORAGE_SECRET_KEY=local_storage_secret
# Path style addresses the bucket as endpoint/bucket/key, which MinIO needs.
STORAGE_PATH_STYLE=true
# A presigned URL is the entire authorisation for the object it names, so its
# lifetime is the window in which a forwarded link works for someone who should
# not have it. config.Load refuses a download TTL over an hour.
STORAGE_UPLOAD_TTL=15m
STORAGE_DOWNLOAD_TTL=10m

# Notifications. `make up` runs Mailpit, which catches everything and delivers
# nothing - a development database full of real addresses would otherwise send
# real people real mail. Its web UI is on http://127.0.0.1:8026.
#
# Leave SMTP_HOST empty to run without mail: the worker then logs what it would
# have sent, which is deliberately not silent - an operator can tell "mail is
# not configured" from "the notification code is broken".
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM_ADDRESS=noreply@localhost
SMTP_FROM_NAME=Expense Tracker
# starttls, implicit or none. Plaintext is refused off loopback, and refused
# outright when credentials are set: SMTP AUTH over an unencrypted connection
# sends the password base64-encoded, which is not encoding anything.
SMTP_TLS=none

# Used for the links in a notification. Empty omits them rather than producing
# "/expenses/..." which resolves to nothing in a mail client.
DASHBOARD_URL=http://localhost:5173

# The Stripe Payment & Subscription Gateway (project #1). Leave BILLING_GATEWAY_URL
# empty to run without billing: every tenant then resolves to the free plan,
# and the API logs a warning saying so at startup.
BILLING_GATEWAY_URL=
BILLING_SERVICE_SECRET=
BILLING_RELAY_SECRET=
